{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "api",
        "--python",
        "3.12",
        "--with-editable",
        ".[dev]",
        "uvicorn",
        "app.main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173,
      "env": {
        "API_URL": "http://localhost:8001"
      }
    }
  ]
}