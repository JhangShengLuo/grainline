# 複製成 .env 並填入其中一個金鑰，AI 提案（console 的「AI 提案」頁）才能使用。.env 不會被 commit。
# 兩個都設時優先用 OpenRouter；走 OpenRouter 時不會把 Anthropic 金鑰送出去。

# 經 OpenRouter 呼叫 Claude（https://openrouter.ai/keys，建議設定額度上限）
OPENROUTER_API_KEY=

# 或直接用 Anthropic API
ANTHROPIC_API_KEY=

# 選用：換模型（OpenRouter 預設 anthropic/claude-opus-5.5，Anthropic 預設 claude-opus-5-5）
GRAINLINE_MODEL=
